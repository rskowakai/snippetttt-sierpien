# --- DATABASE ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db

# --- PGADMIN ---
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- BACKEND ---
# This URL is used by the backend application inside the docker network
DATABASE_URL=postgresql+asyncpg://app_user:app_password@db:5432/app_db
SECRET_KEY=a-very-long-and-super-secret-key-for-jwt-tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- FRONTEND ---
# This URL is used by the browser to connect to the backend
VITE_API_BASE=http://localhost:8000/api/v1
