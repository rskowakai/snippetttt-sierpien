# .env file for local development
# This file should not be committed to version control.

# Environment
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="a-very-secure-secret-key-for-local-development-that-is-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://prawo_user:prawo_password@localhost:5432/prawo_db"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379/0"

# External Services (placeholders)
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_CLOUD_PROJECT="local-dev-project"
GOOGLE_CLOUD_STORAGE_BUCKET="local-dev-bucket"
WEAVIATE_URL="http://localhost:8080"
STRIPE_SECRET_KEY="sk_test_dummy_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_dummy_webhook_secret"
