# --- Application Settings ---
PROJECT_NAME="Document Processing API"
API_V1_STR="/api/v1"
SECRET_KEY=your_super_secret_key_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=dev # dev, prod

# --- Google Gemini API ---
GOOGLE_API_KEY="your_google_api_key_here"
GEMINI_MODEL_NAME="gemini-1.5-flash"

# --- PostgreSQL Database ---
POSTGRES_SERVER=postgres-primary
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app
DATABASE_URL="postgresql+asyncpg://user:password@postgres-primary:5432/app"
# For testing
TEST_DATABASE_URL="postgresql+asyncpg://user:password@postgres-primary:5432/test_app"


# --- Redis (Celery Broker & Cache) ---
REDIS_BROKER_URL="redis://redis-cluster:6379/0"
REDIS_CACHE_URL="redis://redis-cache:6379/0"

# --- Weaviate Vector Database ---
WEAVIATE_URL="http://weaviate:8080"
WEAVIATE_API_KEY="" # Optional, if needed

# --- External Services API Keys ---
OPENAI_API_KEY="your_openai_api_key_if_needed"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="your_s3_bucket_name"

# --- Sentry for Error Tracking ---
SENTRY_DSN=""

# --- Embedding Model ---
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
